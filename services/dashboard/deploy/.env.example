# Kioku Dashboard Deployment Configuration
# Copy this file to .env and fill in the values

# ─── API Connection ─────────────────────────────────────────────────────────
# Internal API URL (Docker network) - used by the dashboard server
VEXA_API_URL=http://vexa-api-gateway:8000

# Public API URL (browser-facing) - where the browser should connect
VEXA_PUBLIC_API_URL=https://api.kioku.chat

# ─── Authentication ─────────────────────────────────────────────────────────
# NextAuth URL (must match the dashboard URL)
NEXTAUTH_URL=https://dashboard.kioku.chat
# Required: run `openssl rand -base64 32` to generate
NEXTAUTH_SECRET=change-me-to-a-random-secret

# Public App URL (for client-side redirects)
NEXT_PUBLIC_APP_URL=https://dashboard.kioku.chat

# Allow direct email login (set to false for production with OAuth)
VEXA_ALLOW_DIRECT_LOGIN=true

# Admin API configuration (required for user management)
VEXA_ADMIN_API_KEY=your_admin_api_key_here
VEXA_ADMIN_API_URL=http://vexa-admin-api:8001

# Optional: Service-level API key (for pre-login browsing)
VEXA_API_KEY=

# ─── OAuth (Optional) ──────────────────────────────────────────────────────
# Google OAuth (optional - enables Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (Optional) ──────────────────────────────────────────────────────
# SMTP configuration for magic link authentication
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# ─── External Links ────────────────────────────────────────────────────────
# Documentation URL
NEXT_PUBLIC_DOCS_URL=https://docs.kioku.chat

# Hosted mode (for SSO with kioku.chat)
NEXT_PUBLIC_HOSTED_MODE=false
NEXT_PUBLIC_WEBAPP_URL=https://kioku.chat

# ─── Bot Configuration ─────────────────────────────────────────────────────
# Default bot name for meetings
DEFAULT_BOT_NAME=Kioku Bot

# ─── Build Information ─────────────────────────────────────────────────────
# Version information (set during build)
NEXT_PUBLIC_VEXA_OSS_VERSION=
NEXT_PUBLIC_VEXA_OSS_RELEASE_DATE=
