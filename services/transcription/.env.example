# ── Backend ───────────────────────────────────────────────────────────────────
# chirp (google/chirp-3) | gpt4o (openai/gpt-4o-mini-transcribe) — cloud via
# OpenRouter; whisper — local whisper.cpp (build with --features local-whisper,
# or --features cuda for GPU).
STT_BACKEND=chirp
OPENROUTER_API_KEY=
# OPENROUTER_URL=https://openrouter.ai/api/v1
# CHIRP_MODEL=google/chirp-3
# GPT4O_MODEL=openai/gpt-4o-mini-transcribe
# OPENROUTER_TIMEOUT_S=60

# Local backend model: ggml name (tiny, base, ..., large-v3-turbo — auto-
# downloaded to ./models) or a path to a .bin. See docs/models.md.
# MODEL_SIZE=large-v3-turbo

# ── Response shaping (cloud backends) ─────────────────────────────────────────
# CHIRP_TARGET_RMS=0.1        # gain quiet audio up to this RMS before upload
# CHIRP_LANGUAGE_LABEL=en     # whisper-valid code used when caller pins none

# ── Auth + load management ────────────────────────────────────────────────────
# API_TOKEN=                  # X-API-Key / Bearer; unset = allow all
# MAX_ACTIVE_REQUESTS=20      # concurrent transcriptions; excess gets 503
# REALTIME_RESERVED_SLOTS=1   # slots the deferred tier may not consume
# BUSY_RETRY_AFTER_S=1        # Retry-After on busy responses
