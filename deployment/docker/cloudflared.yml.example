tunnel: <your-tunnel-id>
credentials-file: /etc/cloudflared/creds/<your-tunnel-id>.json

ingress:
  # The consolidated MCP service handles knowledge and meeting tools.
  # Keep the CLI's historical knowledge MCP URL available on the API host.
  - hostname: api.example.com
    path: ^/mcp(/.*)?$
    service: http://kioku-mcp:18888
    originRequest:
      httpHostHeader: 127.0.0.1:18888
  - hostname: api.example.com
    service: http://kioku-hivemind:9100
  - hostname: meetings.example.com
    service: http://vexa-api-gateway:8000
  - hostname: dashboard.example.com
    service: http://kioku-dashboard:3001
  - hostname: mcp.example.com
    service: http://kioku-mcp:18888
    originRequest:
      httpHostHeader: 127.0.0.1:18888
  - service: http_status:404
