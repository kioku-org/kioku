# ==============================================================================
# Kioku Stateful Pod — all always-on services in one supervisord-managed container
# Build: docker build -f deployment/docker/Dockerfile.stateful -t ghcr.io/kioku-org/kioku-stateful .
# ==============================================================================

# ─── Stage 1: Build hivemind (Rust) ───────────────────────────────────────────
FROM rust:1.88-slim AS hivemind-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev libfontconfig1-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/hivemind/ .
RUN cargo build --release

# ─── Stage 1b: Build api-gateway (Rust) ───────────────────────────────────────
FROM rust:1.88-slim AS api-gateway-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/api-gateway/ .
RUN cargo build --release

# ─── Stage 1c: Build mcp (Rust) ────────────────────────────────────────────────
FROM rust:1.88-slim AS mcp-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/mcp/ .
RUN cargo build --release

# ─── Stage 2: Install Python services into venv ───────────────────────────────
# python:3.11-slim-bookworm puts Python at /usr/local/bin and stdlib at
# /usr/local/lib/python3.11. Stage 4 (Ubuntu 22.04 + deadsnakes) puts Python
# at /usr/bin and stdlib at /usr/lib/python3.11. Patch pyvenv.cfg home path
# after venv creation so the venv resolves correctly at runtime.
FROM python:3.11-slim-bookworm AS python-builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv \
    && sed -i 's|home = /usr/local/bin|home = /usr/bin|' /opt/venv/pyvenv.cfg
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build

# Shared libs
COPY services/libs/schema-sync/ /build/libs/schema-sync/
COPY services/libs/admin-models/ /build/libs/admin-models/
RUN pip install --no-cache-dir /build/libs/schema-sync /build/libs/admin-models

# Packages installed as editable deps by other services
COPY services/meeting-api/ /build/services/meeting-api/
RUN pip install --no-cache-dir /build/services/meeting-api

COPY services/agent-api/ /build/services/agent-api/
RUN pip install --no-cache-dir /build/services/agent-api

COPY services/runtime-api/ /build/services/runtime-api/
RUN pip install --no-cache-dir /build/services/runtime-api

# Requirements for standalone services
COPY services/admin-api/requirements.txt /tmp/admin-api-req.txt
RUN pip install --no-cache-dir -r /tmp/admin-api-req.txt

COPY services/tts-service/requirements.txt /tmp/tts-req.txt
RUN pip install --no-cache-dir -r /tmp/tts-req.txt

# python-pptx for hivemind's PPTX text extraction (services/hivemind/scripts/extract_pptx.py) —
# no mature native-Rust PPTX parser exists, so hivemind shells out to this.
RUN pip install --no-cache-dir python-pptx

# cookie uses only fastapi + uvicorn — already installed above

# Copy all service source into /opt/vexa/services/
RUN mkdir -p /opt/vexa/services
COPY services/admin-api/     /opt/vexa/services/admin-api/
COPY services/meeting-api/   /opt/vexa/services/meeting-api/
COPY services/agent-api/     /opt/vexa/services/agent-api/
COPY services/tts-service/   /opt/vexa/services/tts-service/
COPY services/runtime-api/   /opt/vexa/services/runtime-api/
COPY services/cookie/        /opt/vexa/services/cookie/

# ─── Stage 3: Build dashboard (Next.js standalone) ────────────────────────────
FROM node:20-alpine AS dashboard-builder
WORKDIR /app

COPY services/dashboard/package.json services/dashboard/package-lock.json ./
RUN npm ci --ignore-scripts

COPY services/dashboard/src        ./src
COPY services/dashboard/public     ./public
COPY services/dashboard/scripts    ./scripts
COPY services/dashboard/next.config.ts \
     services/dashboard/tsconfig.json \
     services/dashboard/postcss.config.mjs \
     services/dashboard/eslint.config.mjs \
     services/dashboard/components.json ./

# Server-side rewrites point at the api-gateway inside the same container.
ARG KIOKU_API_URL=http://localhost:8056
ENV KIOKU_API_URL=$KIOKU_API_URL

ARG NEXT_PUBLIC_VEXA_OSS_VERSION=0.1.0
ENV NEXT_PUBLIC_VEXA_OSS_VERSION=$NEXT_PUBLIC_VEXA_OSS_VERSION

RUN npm run build

# ─── Stage 4: Runtime ─────────────────────────────────────────────────────────
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PG_MAJOR=16 \
    OLLAMA_HOST=0.0.0.0:11434 \
    OLLAMA_MODELS=/data/ollama/models \
    PATH="/opt/venv/bin:$PATH"

# Python 3.11 via deadsnakes — same minor version as python-builder so the
# patched pyvenv.cfg home path resolves correctly at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg wget zstd \
        openssh-server redis-server supervisor sudo \
        libicu70 libxml2 \
        tesseract-ocr poppler-utils \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt jammy-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-16 postgresql-16-pgvector postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*

# Qdrant
RUN curl -fsSL https://github.com/qdrant/qdrant/releases/download/v1.10.1/qdrant-x86_64-unknown-linux-gnu.tar.gz \
        -o /tmp/qdrant.tar.gz \
    && tar xzf /tmp/qdrant.tar.gz -C /usr/local/bin qdrant \
    && rm -f /tmp/qdrant.tar.gz \
    && chmod +x /usr/local/bin/qdrant

# Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# MinIO server + mc client
RUN curl -fsSL https://dl.min.io/server/minio/release/linux-amd64/minio \
        -o /usr/local/bin/minio \
    && chmod +x /usr/local/bin/minio \
    && curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc \
        -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc

# Cloudflared
RUN curl -fsSL https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 \
        -o /usr/local/bin/cloudflared \
    && chmod +x /usr/local/bin/cloudflared

# Hivemind binary + its PPTX-extraction helper script
COPY --from=hivemind-builder /app/target/release/kioku-hivemind /usr/local/bin/kioku-hivemind
COPY services/hivemind/scripts/extract_pptx.py /opt/hivemind/scripts/extract_pptx.py

# api-gateway binary
COPY --from=api-gateway-builder /app/target/release/kioku-api-gateway /usr/local/bin/kioku-api-gateway

# mcp binary (consolidates the old Python services/mcp + hivemind's embedded MCP server)
COPY --from=mcp-builder /app/target/release/kioku-mcp /usr/local/bin/kioku-mcp

# Python venv + all service source
COPY --from=python-builder /opt/venv  /opt/venv
COPY --from=python-builder /opt/vexa  /opt/vexa

# Dashboard standalone bundle
COPY --from=dashboard-builder /app/public               /opt/dashboard/public
COPY --from=dashboard-builder /app/.next/standalone/    /opt/dashboard/
COPY --from=dashboard-builder /app/.next/static         /opt/dashboard/.next/static

# Entrypoint
COPY deployment/docker/entrypoint-stateful-runtime.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22 3001 5432 6334 6379 8001 8056 8090 8099 8100 9000 9001 9100 11434 18888

ENTRYPOINT ["/entrypoint.sh"]
