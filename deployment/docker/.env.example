# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=kioku
DB_PASSWORD=kioku
DB_NAME=kioku

# ─── Hivemind (edge service on port 9100) ────────────────────────────────────
HIVEMIND_PORT=9100
HIVEMIND_JWT_SECRET=change-me-to-a-random-64-char-hex-string
HIVEMIND_ENCRYPTION_SECRET=change-me-to-a-random-64-char-hex-string

# ─── Vexa API gateway (edge service on port 8056) ────────────────────────────
VEXA_API_PORT=8056
VEXA_PUBLIC_URL=https://meetings.example.com
VEXA_ADMIN_API_TOKEN=change-me-to-a-random-token
VEXA_BOT_IMAGE=vexa-bot:dev

# ─── Vexa internals ─────────────────────────────────────────────────────────
VEXA_TRANSCRIBER_API_KEY=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_API_KEY=
TTS_API_TOKEN=
INTERNAL_API_SECRET=

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_BACKEND=minio
MINIO_ACCESS_KEY=vexa-access-key
MINIO_SECRET_KEY=vexa-secret-key
MINIO_BUCKET=vexa-recordings
RECORDING_ENABLED=false

# ─── Vector DB ──────────────────────────────────────────────────────────────
QDRANT_API_KEY=

# ─── General ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=*
VEXA_ENV=production

# ─── Build paths (relative to docker-compose file) ──────────────────────────
KIOKU_VEXA_PATH=../../services/vexa
HIVEMIND_PATH=../../services/hivemind

# ─── Dashboard (dashboard.kioku.chat) ────────────────────────────────────────
# Required: random secret for NextAuth session encryption (openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=https://dashboard.kioku.chat
# Optional: allow direct email login without SMTP or OAuth
VEXA_ALLOW_DIRECT_LOGIN=true
# Optional: Google OAuth for sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: SMTP for magic-link email login
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# ─── Cloudflare Tunnel ───────────────────────────────────────────────────────
CLOUDFLARED_CREDENTIALS_DIR=~/.cloudflared
