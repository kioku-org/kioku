# Copy to .env and fill in your values, then run ./deploy.sh
#
# Required — deploy.sh exits immediately if any of these are unset.
RUNPOD_API_KEY=
HIVEMIND_JWT_SECRET=
HIVEMIND_ENCRYPTION_SECRET=
VEXA_ADMIN_API_TOKEN=

# Images — defaults already point at the images CI builds (ghcr.io/kioku-org/*).
# Only override if you're testing a fork or a locally-pushed image.
# IMAGE=ghcr.io/kioku-org/kioku-stateful:latest
# BOT_IMAGE=ghcr.io/kioku-org/kioku-stateless:latest

# Pod sizing / naming (all optional, sane defaults in deploy.sh)
# POD_NAME=kioku-stateful
# CONTAINER_DISK_GB=20
# VOLUME_GB=50
# STATEFUL_RUNPOD_CLOUD_TYPE=COMMUNITY

# Stateful compute type (optional, default CPU). The embedding model hivemind's
# ollama runs (nomic-embed-text-v2-moe) is pathologically slow on CPU — set GPU
# if you're testing document ingestion or knowledge search.
# STATEFUL_COMPUTE_TYPE=GPU
# STATEFUL_GPU_TYPE=NVIDIA GeForce RTX 3090

# Core service config (optional — defaults match the dev-server setup)
# DB_NAME=kioku
# DB_USER=kioku
# DB_PASSWORD=kioku
# REDIS_PASSWORD=kioku-redis
# CORS_ORIGINS=*
# LOG_LEVEL=INFO
# VEXA_ENV=production
# VEXA_PUBLIC_URL=
# INTERNAL_API_SECRET=

# Storage (MinIO, optional)
# STORAGE_BACKEND=minio
# MINIO_ACCESS_KEY=kioku
# MINIO_SECRET_KEY=kioku-minio-password
# MINIO_BUCKET=vexa-recordings
# RECORDING_ENABLED=false

# Bot pod GPU backend (RunPod) — used by runtime-api-runpod inside the stateful
# pod to spawn stateless bot pods automatically when meetings are requested.
# RUNPOD_GPU_TYPES=NVIDIA GeForce RTX 3090,NVIDIA GeForce RTX 5090,NVIDIA RTX A5000,NVIDIA RTX A4000
# RUNPOD_CLOUD_TYPE=COMMUNITY

# Warm bot pool (optional, default 0 = disabled) — keep N stateless bot pods
# pre-spawned and idle (image already pulled) so a real meeting request claims
# one instantly instead of cold-spawning and waiting on a fresh RunPod pod to
# pull the multi-GB stateless image. Each idle slot costs GPU-pod $/hr while
# unclaimed.
# MIN_BOT_POOL=2

# Qdrant (optional)
# QDRANT_API_KEY=

# Integrations (optional — leave blank to disable)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# Dashboard AI chat uses a provider/model pair and its API key.
# AI_MODEL=anthropic/claude-sonnet-5-5
# AI_API_KEY=
# VEXA_TRANSCRIBER_API_KEY=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# TTS_API_TOKEN=

# SSH (optional — paste a public key to enable root SSH into the pod)
# PUBLIC_KEY=

# CPU production with cloud transcription
# STATEFUL_RUNPOD_CLOUD_TYPE=SECURE
# BOT_COMPUTE_TYPE=CPU
# VEXA_ALLOW_DIRECT_LOGIN=false
# STT_BACKEND=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=x-ai/grok-stt-1.0
# EMBEDDING_BASE_MODEL=nomic-embed-text
# EMBEDDING_MODEL=nomic-embed-text-cpu
# CPU_EMBEDDING_THREADS=2

# Startup template created by create_cpu_template.py
# TEMPLATE_ID=
# Durable network volume mounted at /data
# NETWORK_VOLUME_ID=
# STATEFUL_DATA_CENTER_ID=US-CA-2
# VOLUME_GB=0
# NEXTAUTH_URL=
# VEXA_PUBLIC_API_URL=
# Remotely managed Cloudflare Tunnel; token is kept out of process arguments.
# CLOUDFLARE_TUNNEL_TOKEN=
# Optional ingress YAML on the network volume for locally configured routes.
# CLOUDFLARE_CONFIG_PATH=/data/cloudflared/config.yml
# Optional rebuilt standalone dashboard stored on the network volume
# DASHBOARD_RELEASE_DIR=/data/dashboard-releases/<build-id>
# Existing templates: copy dashboard-release.sh to this path before setting it
# BASH_ENV=/data/kioku-dashboard-release.sh

# RunPod network volumes may reject PostgreSQL's ownership/mode requirements.
# Use local PGDATA plus consistent volume backups with startup restore.
# PGDATA=/var/lib/kioku/postgresql
# POSTGRES_BACKUP_DIR=/data/postgresql-backups
# POSTGRES_BACKUP_INTERVAL_SECONDS=60
