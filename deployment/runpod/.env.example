# ─── RunPod Configuration ─────────────────────────────────────────────────────
RUNPOD_API_KEY=your-runpod-api-key-here
RUNPOD_GPU_TYPE="NVIDIA GeForce RTX 3090"
RUNPOD_CLOUD_TYPE=COMMUNITY
STATEFUL_RUNPOD_CLOUD_TYPE=COMMUNITY
CONTAINER_DISK_GB=20
VOLUME_GB=50

# ─── Pod Config ───────────────────────────────────────────────────────────────
POD_NAME=kioku-stateful
IMAGE=kyomoto/kioku-stateful:latest
BOT_IMAGE=kyomoto/kioku-stateless:latest
BROWSER_IMAGE=kyomoto/kioku-stateless:latest

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=kioku
DB_USER=kioku
DB_PASSWORD=kioku

# ─── Redis (exposed publicly — AUTH required) ────────────────────────────────
REDIS_PASSWORD=change-me-to-a-strong-password

# ─── Hivemind ─────────────────────────────────────────────────────────────────
HIVEMIND_JWT_SECRET=change-me-to-a-random-64-char-hex-string
HIVEMIND_ENCRYPTION_SECRET=change-me-to-a-random-64-char-hex-string

# ─── Vexa Admin ───────────────────────────────────────────────────────────────
VEXA_ADMIN_API_TOKEN=change-me-to-a-random-token
INTERNAL_API_SECRET=change-me-to-an-internal-secret

# ─── Vexa Public URL ──────────────────────────────────────────────────────────
VEXA_PUBLIC_URL=https://meetings.example.com

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=minio
MINIO_ACCESS_KEY=kioku
MINIO_SECRET_KEY=kioku-minio-password
MINIO_BUCKET=vexa-recordings
RECORDING_ENABLED=false

# ─── Vector DB ────────────────────────────────────────────────────────────────
QDRANT_API_KEY=

# ─── General ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=*
VEXA_ENV=production

# ─── Optional API Keys ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_API_KEY=
VEXA_TRANSCRIBER_API_KEY=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
TTS_API_TOKEN=

# ─── SSH (optional) ───────────────────────────────────────────────────────────
# PUBLIC_KEY=ssh-rsa AAAAB3NzaC1yc2E...
