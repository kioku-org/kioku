# RunPod Configuration
RUNPOD_API_KEY=your-runpod-api-key-here
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 3090
RUNPOD_GPU_COUNT=1
RUNPOD_VCPU_PER_GPU=8
RUNPOD_RAM_PER_GPU=32
RUNPOD_DISK_GB=50
RUNPOD_VOLUME_GB=50

# Deployment Config
RUNPOD_POD_NAME=kioku-platform

# Service Config (passed to Pod)
DB_NAME=kioku
DB_USER=kioku
DB_PASSWORD=kioku
