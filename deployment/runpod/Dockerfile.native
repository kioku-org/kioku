# ═══════════════════════════════════════════════════════════════════════════════
# Stage 1: Build hivemind from Rust source
# ═══════════════════════════════════════════════════════════════════════════════
FROM rust:1.88-slim AS builder

RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY services/hivemind/ ./hivemind/
RUN cd hivemind && cargo build --release 2>&1 | tail -5

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 2: Runtime with all services
# ═══════════════════════════════════════════════════════════════════════════════
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl wget gnupg2 lsb-release sudo \
    postgresql postgresql-common postgresql-client \
    redis-server \
    python3 python3-pip python3-venv \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Qdrant
RUN curl -sL https://github.com/qdrant/qdrant/releases/download/v1.10.1/qdrant-v1.10.1-x86_64-unknown-linux-gnu.tar.gz | tar xz -C /usr/local/bin/

# Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Copy hivemind binary from builder
COPY --from=builder /build/hivemind/target/release/kioku-hivemind /usr/local/bin/

# PostgreSQL setup
RUN mkdir -p /var/run/postgresql && chown postgres:postgres /var/run/postgresql
RUN echo "host all all 0.0.0.0/0 trust" >> /etc/postgresql/14/main/pg_hba.conf && \
    echo "listen_addresses='*'" >> /etc/postgresql/14/main/postgresql.conf

WORKDIR /workspace

# Copy deployment and runpod files
COPY deployment/docker/ /workspace/kioku/deployment/docker/
COPY deployment/runpod/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY deployment/runpod/entrypoint-native.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Install Python deps for voice services
COPY services/voice/services/api-gateway/requirements.txt /tmp/api-gateway-requirements.txt
COPY services/voice/services/admin-api/requirements.txt /tmp/admin-api-requirements.txt
COPY services/voice/services/meeting-api/requirements.txt /tmp/meeting-api-requirements.txt
COPY services/voice/services/agent-api/requirements.txt /tmp/agent-api-requirements.txt
COPY services/voice/services/transcription-service/requirements.txt /tmp/transcription-requirements.txt
COPY services/voice/services/tts-service/requirements.txt /tmp/tts-requirements.txt
COPY services/voice/services/mcp/requirements.txt /tmp/mcp-requirements.txt

RUN pip3 install --no-cache-dir \
    -r /tmp/api-gateway-requirements.txt \
    -r /tmp/admin-api-requirements.txt \
    -r /tmp/meeting-api-requirements.txt \
    -r /tmp/agent-api-requirements.txt \
    -r /tmp/transcription-requirements.txt \
    -r /tmp/tts-requirements.txt \
    -r /tmp/mcp-requirements.txt 2>&1 | tail -5

# Copy voice services source
COPY services/voice/ /workspace/kioku/services/voice/

# Pull ollama model at build time (cached)
RUN ollama pull nomic-embed-text-v2-moe || true

EXPOSE 80 443 5432 6334 8000 8056 8057 9001 9100 11434 18888

ENTRYPOINT ["/entrypoint.sh"]
