FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PG_MAJOR=16 \
    OLLAMA_HOST=0.0.0.0:11434 \
    OLLAMA_MODELS=/data/ollama/models

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        openssh-server \
        redis-server \
        supervisor \
        sudo \
        wget \
        zstd \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-16 \
        postgresql-16-pgvector \
        postgresql-client-16 \
    && curl -fsSL https://github.com/qdrant/qdrant/releases/download/v1.10.1/qdrant-x86_64-unknown-linux-gnu.tar.gz \
        -o /tmp/qdrant.tar.gz \
    && tar xzf /tmp/qdrant.tar.gz -C /usr/local/bin qdrant \
    && rm -f /tmp/qdrant.tar.gz \
    && chmod +x /usr/local/bin/qdrant \
    && curl -fsSL https://ollama.com/install.sh | sh \
    && curl -fsSL https://dl.min.io/server/minio/release/linux-amd64/minio \
        -o /usr/local/bin/minio \
    && chmod +x /usr/local/bin/minio \
    && rm -rf /var/lib/apt/lists/*

COPY deployment/runpod/entrypoint-stateful-runtime.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22 5432 6379 6334 9000 9001 11434

ENTRYPOINT ["/entrypoint.sh"]
