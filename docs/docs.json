          "getting-started/mcp-cursor-claude"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "core-concepts/meeting-memory",
          "core-concepts/document-memory",
          "core-concepts/agent-context",
          "core-concepts/multi-tenancy"
        ]
      },
      {
        "group": "Deployment",
        "pages": [
          "deployment/docker-compose",
          "deployment/runpod",
          "deployment/gpu-cpu-modes",
          "deployment/production-checklist",
          "deployment/environment-variables"
        ]
      },
      {
        "group": "Security & Privacy",
        "pages": [
          "security/data-flow",
          "security/storage",
          "security/deletion",
          "security/self-hosted-guarantees"
        ]
      },
      {
        "group": "API / CLI / MCP",
        "pages": [
          "api-cli-mcp",
          "mcp/tools",
          "api/authentication",
          "api/vexa"
        ]
      },
      {
        "group": "Troubleshooting",
        "pages": ["troubleshooting"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/kioku-org/kioku"
      }
    ]
